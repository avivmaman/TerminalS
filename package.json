{
  "name": "terminals",
  "version": "0.1.0",
  "description": "A Windows terminal with a searchable history panel and AI command suggestions",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main/main.js && node --check src/preload.js && node --check src/renderer/app.js && node test/redact.test.js && node test/suggestions.test.js && node test/guard.test.js && node test/translate.test.js",
    "icons": "electron scripts/build-icons.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.4.9",
    "@anthropic-ai/sdk": "^0.128.0",
    "@azure/identity": "^4.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "TerminalS",
  "private": true,
  "author": "Aviv Maman",
  "build": {
    "appId": "com.terminals.app",
    "productName": "TerminalS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "src/main/shell-integration/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "TerminalS-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TerminalS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "TerminalS-${version}-portable.exe"
    }
  }
}
